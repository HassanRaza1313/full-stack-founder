# Copy to .env.local. Only names live in git; values never do.
# Locally, nothing but the Supabase lines is needed: every adapter works without its key.

APP_URL=http://localhost:3000

# Supabase: `pnpm db:start` prints these for the local stack
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Turnstile: these are Cloudflare's public test keys, which always pass
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Stripe test mode (pk_test_ / sk_test_), plus the signing secret printed by `stripe listen`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Production only. Leave empty locally, and the adapters do nothing or log to the console
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
